# Copy this file to .env and fill in the values
DATABASE_URL=sqlite+aiosqlite:////data/mediatracker.db
TMDB_API_KEY=your_tmdb_api_key_here
SECRET_KEY=change_this_to_a_long_random_string_at_least_32_chars
ACCESS_TOKEN_EXPIRE_DAYS=30
# Comma-separated list of allowed CORS origins (no trailing slash)
ALLOWED_ORIGINS=http://localhost:5173,https://yourdomain.com

# SMTP — for email verification and password reset
# Gmail example: enable "App Passwords" in Google account settings
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=My Movie Tracker
SMTP_USE_TLS=true